      "name": "Get tenders"
    },
    {
      "parameters": {
        "jsCode": "// Радары — из ноды Get radars; тендеры — со входа (Get tenders)\nconst radars = $('Get radars').all().map(i => i.json);\nconst tenders = $input.all().map(i => i.json);\n\nfunction matches(t, r) {\n  // регион\n  if (!r.regions.includes(t.region)) return false;\n  // ОКПД2: хотя бы один префикс совпадает\n  if (r.okpd_prefixes?.length) {\n    if (!r.okpd_prefixes.some(p => (t.okpd || '').startsWith(p))) return false;\n  }\n  const title = (t.title || '').toLowerCase();\n  // ключевые слова: включить\n  if (r.keywords_include?.length) {\n    if (!r.keywords_include.some(k => title.includes(k.toLowerCase()))) return false;\n  }\n  // ключевые слова: исключить\n  if (r.keywords_exclude?.length) {\n    if (r.keywords_exclude.some(k => title.includes(k.toLowerCase()))) return false;\n  }\n  // цена (НМЦК)\n  if (r.price_min != null && t.price < r.price_min) return false;\n  if (r.price_max != null && t.price > r.price_max) return false;\n  // закон\n  if (r.law !== 'both' && r.law !== t.law) return false;\n  return true;\n}\n\nconst out = [];\nfor (const t of tenders) {\n  for (const r of radars) {\n    if (matches(t, r)) {\n      out.push({ json: {\n        tender_id: t.id,\n        radar_id: r.id,\n        user_id: r.user_id,\n        status: 'new',\n      }});\n    }\n  }\n}\nreturn out;"
      },
