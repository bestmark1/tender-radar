    {
      "parameters": {
        "jsCode": "const matches = $input.all().map(i => i.json);\nif (!matches.length) return [];\nconst fmt = (n) => Number(n).toLocaleString('ru-RU');\nconst lines = matches.map(m => {\n  const t = m.tenders || {};\n  const r = m.radars || {};\n  const dl = t.submission_deadline ? new Date(t.submission_deadline).toLocaleDateString('ru-RU') : '\\u2014';\n  const price = (t.price != null) ? fmt(t.price) + ' \\u20bd' : '\\u2014';\n  return '\\u2022 ' + (t.title || '\\u0411\\u0435\\u0437 \\u043d\\u0430\\u0437\\u0432\\u0430\\u043d\\u0438\\u044f') +\n    '\\n  \\u0417\\u0430\\u043a\\u0430\\u0437\\u0447\\u0438\\u043a: ' + (t.customer || '\\u2014') +\n    '\\n  \\u041d\\u041c\\u0426\\u041a: ' + price + '  \\u00b7  \\u0414\\u0435\\u0434\\u043b\\u0430\\u0439\\u043d: ' + dl +\n    '\\n  \\u0420\\u0430\\u0434\\u0430\\u0440: ' + (r.name || '\\u2014') +\n    '\\n  ' + (t.eis_url || '');\n});\nconst text = '\\ud83c\\udfaf \\u041d\\u043e\\u0432\\u044b\\u0435 \\u0437\\u0430\\u043a\\u0443\\u043f\\u043a\\u0438 \\u043f\\u043e \\u0432\\u0430\\u0448\\u0438\\u043c \\u0440\\u0430\\u0434\\u0430\\u0440\\u0430\\u043c (' + matches.length + '):\\n\\n' + lines.join('\\n\\n');\nreturn [{ json: { text } }];"
      },
      "id": "33333333-3333-4333-8333-333333333303",
      "name": "Build digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
