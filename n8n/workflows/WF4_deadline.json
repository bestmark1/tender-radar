{
  "id": "Wf4DeAdLiNe00aB",
  "name": "WF4 Deadline reminders",
  "nodes": [
    {
      "parameters": {},
      "id": "44444444-4444-4444-8444-444444444401",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -260,
        0
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "44444444-4444-4444-8444-444444444402",
      "name": "Schedule daily 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -260,
        180
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/matches?status=eq.interested&reminded=eq.false&select=id,status,reminded,tenders(title,submission_deadline,eis_url),radars(name,reminder_days)",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE }}"
            }
          ]
        },
        "options": {}
      },
      "id": "44444444-4444-4444-8444-444444444403",
      "name": "Get interested",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -40,
        60
      ]
    },
    {
      "parameters": {
        "jsCode": "const matches = $input.all().map(i => i.json);\nconst now = Date.now();\nconst due = matches.filter(m => {\n  const t = m.tenders || {};\n  if (!t.submission_deadline) return false;\n  const days = (new Date(t.submission_deadline).getTime() - now) / 86400000;\n  const rd = (m.radars && m.radars.reminder_days) || 2;\n  return days >= 0 && days <= rd;\n});\nif (!due.length) return [];\nconst lines = due.map(m => {\n  const t = m.tenders || {};\n  const days = Math.ceil((new Date(t.submission_deadline).getTime() - now) / 86400000);\n  const dl = new Date(t.submission_deadline).toLocaleDateString('ru-RU');\n  return '\\u2022 ' + (t.title || '') + '\\n  \\u0414\\u0435\\u0434\\u043b\\u0430\\u0439\\u043d \\u0447\\u0435\\u0440\\u0435\\u0437 ' + days + ' \\u0434\\u043d.: ' + dl + '\\n  ' + (t.eis_url || '');\n});\nconst ids = due.map(m => m.id).join(',');\nconst text = '\\u23f0 \\u0421\\u043a\\u043e\\u0440\\u043e \\u0434\\u0435\\u0434\\u043b\\u0430\\u0439\\u043d \\u043f\\u043e\\u0434\\u0430\\u0447\\u0438 (' + due.length + '):\\n\\n' + lines.join('\\n\\n');\nreturn [{ json: { text, ids } }];"
      },
      "id": "44444444-4444-4444-8444-444444444404",
      "name": "Filter due",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_TOKEN }}/sendMessage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, text: $json.text, disable_web_page_preview: true }) }}",
        "options": {}
      },
      "id": "44444444-4444-4444-8444-444444444405",
      "name": "Send reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        60
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/matches?id=in.({{ $('Filter due').first().json.ids }})",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ reminded: true }) }}",
        "options": {}
      },
      "id": "44444444-4444-4444-8444-444444444406",
      "name": "Mark reminded",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
